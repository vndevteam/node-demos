{
  "name": "nodejs-demos",
  "version": "1.0.0",
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7"
  },
  "scripts": {
    "commitlint": "commitlint --edit",
    "format": "pnpm -r --workspace-concurrency=1 --filter \"*\" format",
    "lint": "pnpm -r --workspace-concurrency=1 --filter \"*\" lint",
    "pre-commit": "pnpm -r --workspace-concurrency=1 --filter \"*\" pre-commit",
    "pre-push": "pnpm -r --workspace-concurrency=1 --filter \"*\" test",
    "prepare": "husky"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "packageManager": "pnpm@10.34.7+sha512.ba98abc585539933375b5971f4bc6d6c73a1b4b7edc4a879e7d102fe5423d1e02309d67c60a11f04955093a96e521ad9c3b138cdd654ca5be563f378b3ae48bd"
}
