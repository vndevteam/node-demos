{
  "name": "nodejs-demos",
  "version": "1.0.0",
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7"
  },
  "scripts": {
    "commitlint": "commitlint --edit",
    "format": "pnpm -r --workspace-concurrency=1 --filter \"*\" format",
    "lint": "pnpm -r --workspace-concurrency=1 --filter \"*\" lint",
    "pre-commit": "pnpm -r --workspace-concurrency=1 --filter \"*\" pre-commit",
    "pre-push": "pnpm -r --workspace-concurrency=1 --filter \"*\" test",
    "prepare": "husky"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "packageManager": "pnpm@10.34.6+sha512.7e1ae66a83a9143c118cc1944f37cc4f2b8acddeda4b001cfa78908f6e46e45e15292739ca6c9d026426cc757e9318cc98c5551d6a16c165097b0028ba87b4e6"
}
