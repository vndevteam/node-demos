{
  "name": "nodejs-demos",
  "version": "1.0.0",
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7"
  },
  "scripts": {
    "commitlint": "commitlint --edit",
    "format": "pnpm -r --workspace-concurrency=1 --filter \"*\" format",
    "lint": "pnpm -r --workspace-concurrency=1 --filter \"*\" lint",
    "pre-commit": "pnpm -r --workspace-concurrency=1 --filter \"*\" pre-commit",
    "pre-push": "pnpm -r --workspace-concurrency=1 --filter \"*\" test",
    "prepare": "husky"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "packageManager": "pnpm@10.34.8+sha512.f627a8e971343afe49dfd0f63d028234201dfa831d5cb588733e1e5f8db26bf16989a32161ab5c1b4db3b1fdbc373160606b5b89e002df6dd19a85adf91fc5a8"
}
